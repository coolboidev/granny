<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Granny</title>

<style>
html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: black;
}

iframe {
    width: 100%;
    height: 100%;
    border: none;
}

#piracyScreen,
#fbiScreen {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    text-align: center;
    font-family: Arial, sans-serif;
}

#piracyScreen {
    background: black;
}

#fbiScreen {
    background: #001b5e;
}

.title {
    font-size: 70px;
    font-weight: bold;
    margin-top: 12%;
    animation: flash 0.5s infinite;
}

#piracyTitle {
    color: red;
}

#fbiTitle {
    color: white;
}

.message {
    color: white;
    font-size: 28px;
    margin-top: 30px;
    width: 80%;
    margin-left: auto;
    margin-right: auto;
}

@keyframes flash {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
}
</style>
</head>

<body>

<iframe
    id="innerFrame"
    src="https://map-l.github.io/play/granny/"
    allowfullscreen>
</iframe>

<div id="piracyScreen">
    <div class="title" id="piracyTitle">
        PIRACY DETECTED
    </div>

    <div class="message">
        Unauthorized copy detected.
        <br><br>
        Your game session has been terminated.
        <br><br>
        Security systems are collecting evidence...
    </div>
</div>

<div id="fbiScreen">
    <div class="title" id="fbiTitle">
        FBI WARNING
    </div>

    <div class="message">
        This is a fictional warning screen created
        for entertainment purposes.
        <br><br>
        Unauthorized copying and distribution of
        copyrighted works may violate applicable laws.
        <br><br>
        Thank you for playing.
    </div>
</div>

<script>
setTimeout(function () {

    document.getElementById("innerFrame").style.display = "none";
    document.getElementById("piracyScreen").style.display = "block";

    setTimeout(function () {

        document.getElementById("piracyScreen").style.display = "none";
        document.getElementById("fbiScreen").style.display = "block";

    }, 10000);

}, 60000);
</script>

</body>
</html>
